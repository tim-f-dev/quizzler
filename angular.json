{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "quizzler": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "frontend",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "frontend/main.ts",
            "tsConfig": "tsconfig.json",
            "index": false,
            "outputPath": "dist",
            "outputHashing": "none",
            "assets": [{ "glob": "**/*", "input": "public", "output": "/" }]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "9916dc7e-7784-4f4b-bed2-11e285f43ca3"
  }
}
